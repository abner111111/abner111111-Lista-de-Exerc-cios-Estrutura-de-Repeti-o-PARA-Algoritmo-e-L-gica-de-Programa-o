programa
{
	funcao inicio()
	{
		inteiro idade, maior_idade = 0, contador = 0, i
		caracter sexo, olhos, cabelo

		para(i = 1; i <= 500; i++)
		{
			escreva("Sexo (M/F): ")
			leia(sexo)

			escreva("Cor dos olhos (A/V/C): ")
			leia(olhos)

			escreva("Cor dos cabelos (L/C/P): ")
			leia(cabelo)

			escreva("Idade: ")
			leia(idade)

			se(idade > maior_idade)
			{
				maior_idade = idade
			}

			se(sexo == 'F' e idade >= 18 e idade <= 35 e olhos == 'V' e cabelo == 'L')
			{
				contador++
			}
		}

		escreva("\nMaior idade do grupo: ", maior_idade)
		escreva("\nQuantidade de mulheres entre 18 e 35 anos com olhos verdes e cabelos louros: ", contador)
	}
}
