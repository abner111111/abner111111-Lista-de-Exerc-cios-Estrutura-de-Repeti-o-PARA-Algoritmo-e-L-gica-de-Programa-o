programa
{
	funcao inicio()
	{
		inteiro voto
		inteiro candidato1 = 0
		inteiro candidato2 = 0
		inteiro candidato3 = 0
		inteiro candidato4 = 0
		inteiro nulos = 0
		inteiro brancos = 0
		inteiro i

		para(i = 1; i <= 1000; i++)
		{
			escreva("Digite o voto (1 a 6) ou 0 para encerrar: ")
			leia(voto)

			se(voto == 0)
			{
				pare
			}

			escolha(voto)
			{
				caso 1:
					candidato1++
					pare

				caso 2:
					candidato2++
					pare

				caso 3:
					candidato3++
					pare

				caso 4:
					candidato4++
					pare

				caso 5:
					nulos++
					pare

				caso 6:
					brancos++
					pare

				caso contrario:
					escreva("Voto inválido!\n")
			}
		}

		escreva("\nRESULTADO DA ELEIÇÃO\n")
		escreva("Candidato 1: ", candidato1, " votos\n")
		escreva("Candidato 2: ", candidato2, " votos\n")
		escreva("Candidato 3: ", candidato3, " votos\n")
		escreva("Candidato 4: ", candidato4, " votos\n")
		escreva("Votos nulos: ", nulos, "\n")
		escreva("Votos em branco: ", brancos, "\n")
	}
}
